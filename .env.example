# Copia este archivo a .env (git lo ignora) y rellena los valores.
# Es la única fuente de claves del pipeline. En GitHub Actions el propio
# workflow escribe este .env a partir de los secrets del repo; el watcher
# del PC tiene el suyo propio (ver watcher/.env.example).

BALLCHASING_TOKEN=
# Solo necesaria para generar informes (report.py):
ANTHROPIC_API_KEY=
