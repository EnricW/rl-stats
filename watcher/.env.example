# Copia este archivo a .env (en esta misma carpeta, junto a watcher.py)
# y rellena los valores. Nunca subas el .env a GitHub (git lo ignora).

# Token de https://ballchasing.com/upload (obligatorio)
BALLCHASING_TOKEN=
# ID del grupo del equipo: lo que va tras /group/ en su URL (obligatorio)
BALLCHASING_GROUP=

# Opcional: carpeta de replays, si no es la estándar de Windows
# RL_REPLAY_DIR=C:\Users\tu-usuario\Documents\My Games\Rocket League\TAGame\Demos

# Opcionales: para que la web se actualice al momento y no al siguiente cron
# GITHUB_REPO=tuusuario/rl-stats
# GITHUB_PAT=
